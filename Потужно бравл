    if(len>max){dx=dx/len*max;dy=dy/len*max;}
    knob.style.left=(38+dx)+"px";knob.style.top=(38+dy)+"px";
    T3.joy.x=dx/max;T3.joy.y=dy/max;T3.joy.active=true;
  }
  function endJoy(){T3.joy.x=0;T3.joy.y=0;T3.joy.active=false;knob.style.left="38px";knob.style.top="38px";}

