        spawnEnemy();
        document.getElementById("h3res").textContent=Math.floor(amt)+" "+prey();
        document.getElementById("h3tr").textContent=tr;
        save();
      }else{
        createHitEffect(e.position.x,e.position.z);
      }
    }
  }
}

function createExplosion(x,z,size,color){
  for(var i=0;i<18;i++){
    var p=new THREE.Mesh(new THREE.SphereGeometry(0.2+Math.random()*0.4,6,6),new THREE.MeshBasicMaterial({color:color}));
    p.position.set(x+Math.random()*4-2,z+Math.random()*4-2,0);
    p.userData={life:45,velX:(Math.random()-0.5)*0.2,velZ:(Math.random()-0.5)*0.2};
    T3.scene.add(p);
    T3.particles.push(p);
  }
}

function createHitEffect(x,z){
  for(var i=0;i<6;i++){
    var p=new THREE.Mesh(new THREE.SphereGeometry(0.15,8,8),new THREE.MeshBasicMaterial({color:0xffff00}));
    p.position.set(x+Math.random()*2-1,z+Math.random()*2-1,0.1);
    p.userData={life:20,velY:0.15+Math.random()*0.1};
    T3.scene.add(p);
    T3.particles.push(p);
  }
}

function onResize3D(){
  if(!T3.ren||!T3.cam)return;
  T3.cam.aspect=window.innerWidth/window.innerHeight;
  T3.cam.updateProjectionMatrix();
  T3.ren.setSize(window.innerWidth,window.innerHeight);
}

function loop3D(){
  if(!T3.on)return;
  T3.animId=requestAnimationFrame(loop3D);
  var dt=Math.min(T3.clock.getDelta(),0.06);

  // movement
  var mx=0,mz=0;
  if(T3.keys["w"]||T3.keys["arrowup"])mz-=1;
  if(T3.keys["s"]||T3.keys["arrowdown"])mz+=1;
  if(T3.keys["a"]||T3.keys["arrowleft"])mx-=1;
  if(T3.keys["d"]||T3.keys["arrowright"])mx+=1;
  if(T3.keys[" "])T3.playerSpeed=13.5;
  if(T3.joy.active){mx+=T3.joy.x;mz+=T3.joy.y;}

  var len=Math.sqrt(mx*mx+mz*mz);
  if(len>0.05){
    mx/=len;mz/=len;
    T3.player.position.x+=mx*T3.playerSpeed*dt;
    T3.player.position.z+=mz*T3.playerSpeed*dt;
    // arena clamp
    var r=Math.sqrt(T3.player.position.x*T3.player.position.x+T3.player.position.z*T3.player.position.z);
    if(r>23){T3.player.position.x*=23/r;T3.player.position.z*=23/r;}
    T3.player.rotation.y=Math.atan2(mx,mz);
  }
  if(T3.keys[" "]===true){T3.keys[" "]=null;T3.playerSpeed=8.5*(getH().mult||1);}

  // camera
  T3.cam.position.x+=(T3.player.position.x-T3.cam.position.x)*0.09;
  T3.cam.position.z+=(T3.player.position.z+12-T3.cam.position.z)*0.09;
  T3.cam.position.y=13;
  T3.cam.lookAt(T3.player.position.x,1.2,T3.player.position.z);

  // pickups
  for(var i=T3.pickups.length-1;i>=0;i--){
    var p=T3.pickups[i];
    p.rotation.y+=dt*3;
    p.position.y=0.4+Math.sin(performance.now()/250+i)*0.12;
    var dx=p.position.x-T3.player.position.x,dz=p.position.z-T3.player.position.z;
    if(dx*dx+dz*dz<2.5){
      T3.scene.remove(p);T3.pickups.splice(i,1);
      amt+=hClick();document.getElementById("h3res").textContent=Math.floor(amt)+" "+prey();
      spawnPickup();save();
    }
  }

  // enemies
  var px=T3.player.position.x,pz=T3.player.position.z;
  for(var i=0;i<T3.enemies.length;i++){
    var e=T3.enemies[i];
    var dx=px-e.position.x,dz=pz-e.position.z;
    var d=Math.sqrt(dx*dx+dz*dz)||1;
    e.position.x+=dx/d*e.userData.spd*dt;
    e.position.z+=dz/d*e.userData.spd*dt;
    e.rotation.y+=dt*2.5;

    // enemy attack
    if(Math.random()<0.03){
      e.userData.hp-=hClick()*0.6;
      createHitEffect(e.position.x,e.position.z);
      if(e.userData.hp<=0){
        createExplosion(e.position.x,e.position.z,1.5,0xff2222);
        T3.scene.remove(e);T3.enemies.splice(i,1);
        spawnEnemy();
      }
    }
  }

  // particles
  for(var i=T3.particles.length-1;i>=0;i--){
    var p=T3.particles[i];
    p.position.x+=p.userData.velX||0;
    p.position.z+=p.userData.velZ||0;
    p.position.y+=p.userData.velY||0.08;
    p.userData.life--;
    if(p.userData.life<=0){T3.scene.remove(p);T3.particles.splice(i,1);continue;}
    p.scale.setScalar(p.userData.life/40);
  }

  // minimap
  if(T3.minimapOn){
    var mmC=document.getElementById("mmCanvas");
    if(mmC){
      var ctx=mmC.getContext("2d");
      ctx.fillStyle="#0a2540";
      ctx.fillRect(0,0,180,180);
      // arena
      ctx.strokeStyle="#7ec8e3";
      ctx.lineWidth=3;
      ctx.beginPath();
      ctx.arc(90,90,110,0,Math.PI*2);
      ctx.stroke();
      // player
      ctx.fillStyle="#a8e6ff";
      ctx.fillRect(90+Math.floor(T3.player.position.x*5),90+Math.floor(T3.player.position.z*5),6,6);
      // enemies
      ctx.fillStyle="#ff4444";
      T3.enemies.forEach(e=>{
        var ex=Math.floor(e.position.x*5+90);
        var ez=Math.floor(e.position.z*5+90);
        if(ex>0&&ex<180&&ez>0&&ez<180)ctx.fillRect(ex,ez,5,5);
      });
    }
  }

  T3.ren.render(T3.scene,T3.cam);
}

setInterval(()=>{if(user)save();},3000);
showAcc();
